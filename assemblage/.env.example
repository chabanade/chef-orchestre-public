# Kit d'assemblage - variables. Copier en .env (gitignore) puis remplir.
# .env n'est JAMAIS dans git. Sur un poste de cabinet, le disque hote doit
# etre chiffre (BitLocker/LUKS) : c'est ce qui protege ce .env et les volumes.

# Cle d'acces au routeur (generer une longue chaine aleatoire).
LITELLM_MASTER_KEY=sk-remplacer-par-une-vraie-cle-aleatoire

# Passphrase du coffre du Pupitre (deverrouille l'historique + le corpus RAG).
# En conteneur il n'y a pas de saisie au terminal : elle passe par ici.
# Compromis assume du kit Docker ; option durcie = docker secrets.
CHEF_PUPITRE_PASSPHRASE=remplacer-par-une-vraie-passphrase

# Cle API Anthropic pour la route cloud (vide = route cloud dormante,
# tout reste local : parfait pour une demo confidentielle).
ANTHROPIC_API_KEY=
