# ============================================================
# Chef d'Orchestre - variables d'environnement
# Copier en .env puis remplir. Regle absolue : les valeurs reelles ne
# passent JAMAIS par le chat ni par git (.env est dans .gitignore).
# ============================================================

# Cle d'acces au routeur (a generer : une longue chaine aleatoire)
LITELLM_MASTER_KEY=sk-remplacer-par-une-vraie-cle-aleatoire

# Cle API Anthropic pour la route cloud (laisser vide = route cloud dormante)
ANTHROPIC_API_KEY=

# Ou tourne Ollama (defaut local)
OLLAMA_API_BASE=http://localhost:11434

# Modele local (qwen3:4b partout ; qwen3:14b ou plus sur machine GPU)
OLLAMA_MODEL=qwen3:4b

# Port du routeur
CHEF_PORT=4000

# Seuil "tache lourde" en caracteres (pilier complexite)
CHEF_SEUIL_LOURD=4000

# La loupe (detection fine PII) : liste de moteurs, union des trouvailles.
#   gliner             -> un moteur (defaut)
#   gliner,presidio    -> DOUBLE VERIFICATION (donnees ultra-sensibles : sante, avocat)
#   off                -> loupe coupee (regles seules)
CHEF_DETECTION_FINE=gliner
# Mode strict : 1 = si un moteur demande manque, TOUT reste en local
# tant que la double verification promise n'est pas effective.
CHEF_LOUPE_STRICTE=0
# Seuil de confiance de la loupe (0.3 = rappel d'abord, recommande en fail-closed)
CHEF_SEUIL_FIN=0.3

# Routes considerees LOCALES (default-deny : tout le reste = sortie).
# Chaque nom liste ici DOIT pointer un backend local (ollama_*) dans config.yaml.
CHEF_ROUTES_LOCALES=local-sensible,chef-auto

# Packs pays (amelioration continue sous VOTRE GO, voir packs-pays/README.md).
# La vigie alerte quand un document sort des cases connues ; vous renseignez
# l'origine et activez le pack ici, puis redemarrez. Ex : bresil,inde,chine
CHEF_PACKS_PAYS=
# Seuil de la vigie : nb de caracteres d'une ecriture etrangere (cyrillique,
# arabe, chinois...) a partir duquel le document est signale hors couverture.
CHEF_SEUIL_ECRITURE=12
# Le carnet de doleances de la vigie (metadonnees seulement, jamais le contenu)
#CHEF_ALERTES=alertes-couverture.jsonl

# Route "methode de l'armoire" (opt-in) : pseudonymise puis cloud,
# re-personnalisation au retour, table jamais sortie de la machine.
CHEF_ROUTE_PSEUDO=cloud-pseudo

# 2e rideau (jour J) : adresses des 2 conteneurs Presidio LOCAUX
# (voir rideau-presidio/). A remplir seulement quand on decommente le
# bloc "guardrails" de config.yaml.
#PRESIDIO_ANALYZER_API_BASE=http://localhost:5002
#PRESIDIO_ANONYMIZER_API_BASE=http://localhost:5001

# Armoire de SESSION : meme conversation = memes jetons (pour iterer).
# 1 = actif (defaut). 0 = brulage apres chaque aller-retour (securite max).
CHEF_ARMOIRE_SESSION=1
# L'armoire d'une session est brulee apres N minutes d'inactivite.
CHEF_ARMOIRE_TTL_MINUTES=30
# Nombre maximal de sessions simultanees en memoire.
CHEF_ARMOIRE_MAX_SESSIONS=50
